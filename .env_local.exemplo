# Exemplo mínimo de variáveis de ambiente para o projeto Squad11
# Valores padrão para desenvolvimento local com PostgreSQL

DJANGO_SECRET_KEY=django-insecure-prisma-local-key
DEBUG=True

DATABASE_ENGINE=postgresql
DATABASE_NAME=polls
DATABASE_USERNAME=myprojectuser
DATABASE_PASSWORD=password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=

PORT=8000
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
