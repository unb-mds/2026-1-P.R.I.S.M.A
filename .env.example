# Exemplo mínimo de variáveis de ambiente para o projeto Squad11
# Substitua os valores antes de usar em produção

DJANGO_SECRET_KEY=troque_por_uma_chave_segura
DEBUG=True
# Configuração do PostgreSQL usada no Docker
DATABASE_ENGINE=postgresql
DATABASE_NAME=squad11
DATABASE_USERNAME=squad11
DATABASE_PASSWORD=squad11
DATABASE_HOST=db
DATABASE_PORT=5432

# Porta que o app Django deve expor (opcional, dependendo do Dockerfile)
PORT=8000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1